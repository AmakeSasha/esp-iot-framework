<?xml version="1.0" encoding="UTF-8"?>
<project version="1">
    <builddir>esp-iot-framework_cppcheck</builddir>
    <analyze-all-vs-configs>false</analyze-all-vs-configs>
    <check-headers>true</check-headers>
    <check-unused-templates>true</check-unused-templates>
    <inline-suppression>true</inline-suppression>
    <max-ctu-depth>8</max-ctu-depth>
    <max-template-recursion>100</max-template-recursion>
    <includedir>
        <dir name="examples/hello_world/build/config"/>
        <dir name="components/esp_iot_framework_core/include"/>
        <dir name="components/esp_iot_framework_core/private_include"/>
        <dir name="components/esp_iot_framework_device/include"/>
        <dir name="components/esp_iot_framework_device/private_include"/>
        <dir name="components/jsmn/include"/>
        <dir name="components/json_generator/include"/>
        <dir name="D:/embedded/esp-idf-v4.4.8/components/esp_common/include"/>
        <dir name="D:/embedded/esp-idf-v4.4.8/components/nvs_flash/include"/>
        <dir name="D:/embedded/esp-idf-v4.4.8/components/esp_rom/include"/>
        <dir name="D:/embedded/esp-idf-v4.4.8/components/mdns/include"/>
        <dir name="D:/embedded/esp-idf-v4.4.8/components/esp_wifi/include"/>
        <dir name="D:/embedded/esp-idf-v4.4.8/components/freertos/include"/>
        <dir name="D:/embedded/esp-idf-v4.4.8/components/freertos/port/xtensa/include"/>
    </includedir>
    <defines>
        <define name="__CPPCHECK__"/>
        <define name="HTTPD_SOCK_ERR_TIMEOUT=-3"/>
        <define name="HTTPD_204=204"/>
    </defines>
    <paths>
        <dir name="components/esp_iot_framework_core"/>
        <dir name="components/esp_iot_framework_device"/>
    </paths>
    <libraries>
        <library>gnu</library>
    </libraries>
    <suppressions>
        <suppression>unusedFunction</suppression>
        <suppression fileName="*/embedded/*">*</suppression>
        <suppression>missingIncludeSystem</suppression>
        <suppression>misra-c2012-21.3</suppression>
        <suppression>misra-c2012-17.3</suppression>
        <suppression fileName="examples/*">*</suppression>
        <suppression>misra-c2012-8.7</suppression>
        <suppression>misra-c2012-2.5</suppression>
        <suppression fileName="components/jsmn/*">*</suppression>
        <suppression fileName="components/json_generator/*">*</suppression>
    </suppressions>
    <addons>
        <addon>misra</addon>
    </addons>
    <check-level-exhaustive/>
    <project-name>esp-iot-framework</project-name>
</project>
